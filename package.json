{
  "name": "pi-turing",
  "version": "0.2.0",
  "description": "Turing: research for the questions behind your code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javiermolinar/pi-turing.git"
  },
  "homepage": "https://github.com/javiermolinar/pi-turing#readme",
  "bugs": {
    "url": "https://github.com/javiermolinar/pi-turing/issues"
  },
  "type": "module",
  "license": "MIT",
  "bin": {
    "pi-turing": "install.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "research"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "extensions",
    "src",
    "web",
    "skills",
    "assets",
    "install.mjs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:backend": "tsx --test tests/native-backend.test.ts tests/native-runner.test.ts tests/extraction.test.ts tests/public-http.test.ts",
    "test:browser": "tsx scripts/preview.ts && tsx scripts/preview-inventory.ts && tsx scripts/preview-notebook.ts && tsx scripts/preview-controls.ts && tsx scripts/preview-assessment.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "htmlparser2": "^10.1.0",
    "ipaddr.js": "^2.5.0",
    "katex": "^0.18.7",
    "linkedom": "^0.18.13",
    "marked": "^17.0.0",
    "pdfjs-dist": "^6.3.289",
    "proper-lockfile": "^4.1.2",
    "sanitize-html": "^2.17.0",
    "undici": "^7.29.1",
    "yaml": "^2.9.1",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/sanitize-html": "^2.16.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.58.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
